<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    android:paddingTop="60dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Post Surplus Food"
            android:textColor="#1565C0"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- 1. Item Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food Title"
            android:textStyle="bold"
            android:textColor="#37474F"/>
        <EditText
            android:id="@+id/etFoodTitle"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g., 3 Boxes of Fried Rice"
            android:layout_marginBottom="16dp"/>

        <!-- 2. Category Spinner -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textStyle="bold"
            android:textColor="#37474F"/>
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0"/>

        <!-- 3. Quantity Slider (SeekBar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Quantity (Servings/Items)"
                android:textStyle="bold"
                android:textColor="#37474F"/>

            <TextView
                android:id="@+id/tvQuantityDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textColor="#1565C0"
                android:textStyle="bold"/>
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50"
            android:progress="0"
            android:layout_marginBottom="16dp"/>

        <!-- 4. Expiry Time Window -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expiry Time Window"
            android:textStyle="bold"
            android:textColor="#37474F"/>
        <EditText
            android:id="@+id/etExpiryTime"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g., Collect by 8:00 PM today"
            android:layout_marginBottom="16dp"/>

        <!-- 5. Pickup Location -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pickup Location"
            android:textStyle="bold"
            android:textColor="#37474F"/>
        <EditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="e.g., Wangsa Maju Block B"
            android:layout_marginBottom="32dp"/>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitDonation"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Post Food Donation"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32" />

    </LinearLayout>
</ScrollView>